    "check": "npm run typecheck && npm run lint && npm run spec"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.2",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
