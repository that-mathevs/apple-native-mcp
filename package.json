{
  "name": "apple-native-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An MCP server for the native macOS apps: Calendar, Reminders, Contacts, Messages, Notes and Mail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/that-mathevs/apple-native-mcp.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "spec": "vitest run",
    "spec:watch": "vitest",
    "spec:mac": "vitest run --config vitest.mac.config.ts",
    "helper:build": "swift build -c release --package-path native",
    "helper:spec": "swift test --package-path native",
    "check": "npm run typecheck && npm run lint && npm run spec && npm run helper:spec"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.2",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "bin": {
    "apple-native-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "native/Sources",
    "native/Package.swift",
    "native/Info.plist",
    "README.md",
    "LICENSE"
  ]
}
