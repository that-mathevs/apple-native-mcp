{
  "name": "apple-native-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An MCP server for the native macOS apps: Calendar, Reminders, Contacts, Messages, Notes and Mail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/that-mathevs/apple-native-mcp.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
